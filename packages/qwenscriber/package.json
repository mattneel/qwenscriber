{
  "name": "@qwenscriber/qwenscriber",
  "version": "0.1.0",
  "description": "Local-first Qwen3-ASR runtime bindings: typed TypeScript over the qwenscriber WASM core.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/inference.worker.d.ts",
      "default": "./dist/worker/inference.worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy_wasm.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
