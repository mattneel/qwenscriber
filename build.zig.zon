.{
    .name = .qwenscriber,
    .version = "0.0.0",
    .fingerprint = 0xe825f8848c516e58, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0-dev.2251+1175a3e99",
    // Qwenscriber deliberately has no Zig package dependencies. The browser
    // runtime must stay dependency-free, and the conversion tooling only needs
    // the standard library.
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
